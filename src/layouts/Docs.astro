---
import '../styles/global.css';
import '../styles/docs.css';
import ThemeHead from '../components/ThemeHead.astro';
import SearchModal from '../components/SearchModal.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { groups, GITHUB, editUrl } from '../data/sidebar.js';

interface Heading {
  id: string;
  text: string;
  depth: 2 | 3;
}
interface PageLink {
  label: string;
  href: string;
}
interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  current: string;
  editPath: string;
  headings: Heading[];
  prev?: PageLink | null;
  next?: PageLink | null;
  wide?: boolean;
}
const {
  title,
  description,
  ogTitle = title,
  current,
  editPath,
  headings,
  prev = null,
  next = null,
  wide = false,
} = Astro.props;
const pageTitle = `${title} | 에듀노드(EduNod) 문서`;

const toc: { id: string; text: string; children: Heading[] }[] = [];
for (const h of headings) {
  if (h.depth === 2 || toc.length === 0) toc.push({ id: h.id, text: h.text, children: [] });
  else toc[toc.length - 1].children.push(h);
}
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta name="theme-color" content="#1f6f54" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ThemeHead />
  </head>
  <body class="doc">
    <a class="doc-skip" href="#_top">본문으로 바로가기</a>

    <header class="doc-header">
      <div class="doc-header-inner">
        <a class="doc-brand" href="/">
          <img class="doc-brand-mark" src="/favicon.svg" alt="" width="28" height="28" />
          <span class="doc-brand-name">EduNod</span>
          <span class="doc-brand-tag">교육 가이드</span>
        </a>

        <button class="doc-search" type="button" aria-label="문서 및 기능 검색 열기" data-search>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="m20 20-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <span class="doc-search-label">문서 및 기능 검색…</span>
          <kbd class="doc-search-kbd"><kbd>Ctrl</kbd><kbd>K</kbd></kbd>
        </button>

        <div class="doc-header-tools">
          <a class="doc-studio-pill" href="/studio/">스튜디오 체험</a>
          <a class="doc-icon-link" href={GITHUB} rel="noopener noreferrer" target="_blank" aria-label="GitHub 저장소 열기">
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
              />
            </svg>
          </a>
          <label class="doc-theme">
            <span class="sr-only">화면 테마 선택</span>
            <svg class="doc-theme-icon" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
              <rect x="3" y="4" width="18" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="2" />
              <path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <select data-theme aria-label="화면 테마 선택">
              <option value="auto" selected>자동 테마</option>
              <option value="light">밝은 테마</option>
              <option value="dark">어두운 테마</option>
            </select>
            <svg class="doc-theme-caret" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
              <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" />
            </svg>
          </label>
        </div>

        <button class="doc-menu-btn" type="button" aria-expanded="false" aria-controls="doc-sidebar" aria-label="문서 메뉴 열기" data-menu>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </header>

    <div class="doc-shell">
      <nav class="doc-sidebar" id="doc-sidebar" aria-label="문서 탐색">
        <div class="doc-sidebar-pane">
          <ul class="doc-groups">
            {groups.map((g) => (
              <li>
                <details class="doc-group" open>
                  <summary>
                    <span>{g.label}</span>
                    <svg class="doc-caret" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                      <path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </summary>
                  <ul class="doc-links">
                    {g.items.map((i) => (
                      <li>
                        <a href={i.href} aria-current={i.slug === current ? 'page' : undefined}>
                          <span>{i.label}</span>
                          {i.badge && <span class="doc-badge">{i.badge}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ))}
          </ul>
          <div class="doc-sidebar-foot">
            <a class="doc-studio-pill" href="/studio/">인터랙티브 스튜디오 열기</a>
            <button type="button" class="doc-btn doc-btn--ghost" data-theme-cycle>테마 전환 (라이트/다크)</button>
          </div>
        </div>
      </nav>

      <div class={`doc-body${wide ? ' doc-body--wide' : ''}`}>
        <div class="doc-toc">
          <nav class="doc-toc-mnav" aria-labelledby="toc-mobile-title">
            <details class="doc-toc-mobile">
              <summary>
                <span id="toc-mobile-title">이 페이지 목차</span>
                <span class="doc-toc-current" data-toc-current>개요</span>
                <svg class="doc-caret" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                  <path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </summary>
              <ul>
                <li><a href="#_top">개요</a></li>
                {toc.map((t) => (
                  <li>
                    <a href={`#${t.id}`}>{t.text}</a>
                    {t.children.length > 0 && (
                      <ul>
                        {t.children.map((c) => (
                          <li><a href={`#${c.id}`}>{c.text}</a></li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </details>
          </nav>

          <aside class="doc-toc-desktop" aria-labelledby="toc-desktop-title">
            <nav aria-labelledby="toc-desktop-title">
              <div class="doc-toc-inner">
                <h2 class="doc-toc-title" id="toc-desktop-title">이 페이지 목차</h2>
                <ul data-toc-list>
                  <li><a href="#_top" aria-current="true">개요</a></li>
                  {toc.map((t) => (
                    <li>
                      <a href={`#${t.id}`}>{t.text}</a>
                      {t.children.length > 0 && (
                        <ul>
                          {t.children.map((c) => (
                            <li><a href={`#${c.id}`}>{c.text}</a></li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </nav>
          </aside>
        </div>

        <div class="doc-column">
          <main id="_top" class="doc-main" tabindex="-1">
            <div class="doc-container">
              <h1 class="doc-title">{title}</h1>
              <slot name="lead" />
              <div class="doc-prose">
                <slot />
              </div>
            </div>
          </main>

          <footer class="doc-footer">
            <div class="doc-footer-meta">
              <a class="doc-edit" href={editUrl(editPath)} rel="noopener noreferrer" target="_blank">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                  <path d="M4 20h4L19 9l-4-4L4 16v4Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                </svg>
                오픈소스 문서 제안하기
              </a>
              <p class="doc-updated">최종 업데이트: <time datetime="2026-11-12">2026년 11월 12일</time></p>
            </div>

            <div class="doc-pagination">
              {prev ? (
                <a class="doc-page-card" href={prev.href} rel="prev">
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                    <path d="m15 6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>
                    <span class="doc-page-dir">이전 문서</span>
                    <span class="doc-page-label">{prev.label}</span>
                  </span>
                </a>
              ) : (
                <span />
              )}
              {next ? (
                <a class="doc-page-card doc-page-card--next" href={next.href} rel="next">
                  <span>
                    <span class="doc-page-dir">다음 문서</span>
                    <span class="doc-page-label">{next.label}</span>
                  </span>
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                    <path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              ) : (
                <span />
              )}
            </div>
          </footer>
        </div>
      </div>
    </div>

    <SearchModal />
    <CookieBanner />

    <script>
      const btn = document.querySelector('[data-menu]');
      btn?.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', String(open));
        document.body.toggleAttribute('data-menu-open', open);
      });

      document.querySelectorAll('.doc-toc-mobile a').forEach((a) =>
        a.addEventListener('click', () => a.closest('details')?.removeAttribute('open'))
      );

      // Accessible Tabs
      document.querySelectorAll('.doc-tabs').forEach((tabs) => {
        const buttons = [...tabs.querySelectorAll('[role="tab"]')];
        const panels = [...tabs.querySelectorAll('[role="tabpanel"]')];
        buttons.forEach((b, i) =>
          b.addEventListener('click', () => {
            buttons.forEach((x, j) => {
              const selected = i === j;
              x.setAttribute('aria-selected', String(selected));
              (x as HTMLElement).tabIndex = selected ? 0 : -1;
              (panels[j] as HTMLElement).hidden = !selected;
            });
          })
        );
      });

      // Scroll-spy for TOC active heading highlight
      const tocLinks = [...document.querySelectorAll('[data-toc-list] a')];
      const mobileCurrent = document.querySelector('[data-toc-current]');
      const targets = tocLinks
        .map((a) => {
          const id = a.getAttribute('href')?.slice(1);
          return id ? document.getElementById(id) : null;
        })
        .filter(Boolean) as HTMLElement[];

      if (targets.length && 'IntersectionObserver' in window) {
        const obs = new IntersectionObserver(
          (entries) => {
            const visible = entries.find((e) => e.isIntersecting);
            if (!visible) return;
            const activeHref = `#${visible.target.id}`;
            tocLinks.forEach((a) => {
              const match = a.getAttribute('href') === activeHref;
              if (match) {
                a.setAttribute('aria-current', 'true');
                if (mobileCurrent && a.textContent) mobileCurrent.textContent = a.textContent;
              } else {
                a.removeAttribute('aria-current');
              }
            });
          },
          { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
        );
        targets.forEach((el) => obs.observe(el));
      }
    </script>
  </body>
</html>
