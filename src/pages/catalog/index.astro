  <!-- 고해상도 이미지/GIF 확대 라이트박스 모달 -->
  <div class="en-modal-backdrop" id="cat-lightbox" hidden>
    <div role="dialog" aria-modal="true" aria-label="카탈로그 이미지 확대 보기" style="display:flex;flex-direction:column;align-items:center;gap:12px;">
      <img id="cat-lightbox-img" class="cat-lightbox-img" src="/catalog/shot-director-briefing.png" alt="확대된 카탈로그 화면 이미지" />
      <button type="button" class="lp-btn lp-btn-primary" id="cat-lightbox-close">확대 창 닫기 (ESC)</button>
    </div>
  </div>

  <script is:inline>
    (function () {
      // 1. Print Brochure button
      var printBtn = document.getElementById('print-catalog-btn');
      if (printBtn) {
        printBtn.addEventListener('click', function () {
          window.print();
        });
      }

      // 2. Interactive Architecture Node Inspector
      var ARCH_DATA = [
        {
          title: '① 학원 · 학교 현장 입력 채널 (읽기 전용 안전 연결)',
          desc: '등·하원 출결 키오스크, 결제선생 수납 시트, 주간 테스트 채점표, Google Classroom·Canvas 데이터를 비밀번호 저장 없이 최소 권한으로 읽어옵니다.',
        },
        {
          title: '② 로컬 격리 워크스페이스 & 역할별 RBAC 필터',
          desc: '모든 원생·학생 기록은 로컬 디스크에 격리됩니다. 강사·조교(TA) 역할로 호출될 경우 서버 단에서 원비 수납 금액과 퇴원 위험 메모를 삭제한 뒤 AI에 전달합니다.',
        },
        {
          title: '③ 멀티 AI 추론 엔진 (Gemini · Claude · 폐쇄망 Ollama)',
          desc: 'Google Gemini 2.5 Flash와 Anthropic Claude Sonnet 간 자동 페일오버를 지원하며, 내부망 Ollama 연결 시 외부 전송 0바이트·추가 비용 ₩0으로 동작합니다.',
        },
        {
          title: '④ Trust Check 독립 승인 게이트 (무단 외부 행동 0건)',
          desc: 'AI 모델이 propose_external_message 도구를 호출하더라도 실제 발송 API로 직행하지 못하고 승인 대기함에 격리되며, 주민등록번호 패턴은 자동 치환됩니다.',
        },
        {
          title: '⑤ 원장 · 교사 최종 검토 및 감사 로그(Audit Trail)',
          desc: '원장님·선생님이 승인 대기함에서 초안 문구를 직접 수정하고 [최종 발송 승인]을 눌렀을 때만 발송되며, 모든 실행 내역이 시간순 감사 로그에 남습니다.',
        },
      ];

      var archNodes = document.querySelectorAll('.cat-arch-node[data-arch]');
      var archTitle = document.getElementById('arch-ins-title');
      var archDesc = document.getElementById('arch-ins-desc');
      archNodes.forEach(function (node) {
        function activate() {
          var item = ARCH_DATA[Number(node.getAttribute('data-arch'))];
          if (!item) return;
          archTitle.textContent = item.title;
          archDesc.textContent = item.desc;
        }
        node.addEventListener('click', activate);
        node.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            activate();
          }
        });
      });

      // 3. Screenshot Gallery Tabs
      var SHOTS = [
        {
          src: '/catalog/shot-director-briefing.png',
          url: 'localhost:4321/studio — 학원 운영자(원장) 브리핑 & KPI',
          badge: '학원 운영자(원장·실장) 모드',
          title: '출근 직후 3분 만에 파악하는 출결 · 수납 · 입학 상담 지표',
          desc: '등원 출결률(91.7%), 이번 달 원비 수납률(94.2%), 신규 레벨테스트 상담, 휴·퇴원 조기 주의군을 상단 KPI 카드와 실행 체크리스트로 요약합니다.',
          points: [
            '실시간 AI 브리핑 생성: 로컬 원생 데이터를 분석해 새 브리핑 카드를 즉시 추가합니다.',
            '월간 예산 가드레일: 좌측 미터기에서 토큰 사용액과 상한선을 실시간 감시합니다.',
            '투명한 감사 추적: 우측 레일에 키오스크 스캔과 발송 보류 내역이 초 단위로 기록됩니다.',
          ],
        },
        {
          src: '/catalog/shot-trust-approvals.png',
          url: 'localhost:4321/studio — [2. 최종 승인 대기함 (Trust Check)]',
          badge: '오발송 원천 차단 게이트',
          title: '미등원 안심 확인부터 결제선생 원비 안내까지 결재 후 전송',
          desc: 'AI가 작성한 모든 학부모 알림톡과 공지 초안이 수신 범위 배지와 함께 대기합니다. 텍스트 상자에서 문구를 바로 고치고 승인하거나 반려할 수 있습니다.',
          points: [
            '긍정 피드백 우선 원칙: 미납 안내문에도 최근 주간평가 성취 칭찬 문구를 먼저 배치합니다.',
            '수신 대상 명시: 개별 학부모 발송인지 반 전체 발송인지 명확히 구분합니다.',
            '강사 상신 지원: 강사·조교가 검토한 초안은 원장 결재함으로 안전하게 상신됩니다.',
          ],
        },
        {
          src: '/catalog/shot-live-agent-chat.png',
          url: 'localhost:4321/studio — [4. 실제 AI 에이전트 지시 및 도구 실행]',
          badge: '실시간 LLM Tool-Calling',
          title: '실제 Gemini · Claude 에이전트가 로컬 원생 조회 후 초안 등록',
          desc: '지시어를 전송하면 서버 에이전트가 원생 출결·성적·기억장을 직접 조회하고 도구를 실행한 뒤, 사용된 모델·토큰·비용과 바로가기 버튼을 함께 반환합니다.',
          points: [
            '원클릭 추천 프롬프트 칩으로 자주 쓰는 학원·교무 업무를 즉시 실행합니다.',
            '메시지 하단에 실행 엔진(Google gemini-2.5-flash 등)과 토큰 비용이 투명하게 표시됩니다.',
            '생성된 승인 카드나 클리닉 학습지로 한 번에 이동하는 점프 버튼을 제공합니다.',
          ],
        },
        {
          src: '/catalog/shot-instructor-clinic.png',
          url: 'localhost:4321/studio — 학원 강사(클리닉) 모드 & 쌍둥이 문항 생성',
          badge: '학원 강사 · 수업 클리닉 모드',
          title: '커트라인 미달 원생 맞춤형 오답 클리닉 변형 문항 즉시 출제',
          desc: '주간평가 70점 미달 원생의 취약 단원(예: 제한된 변역에서 이차함수의 최대·최소)을 겨냥한 변형 문항과 강사용 지도 핵심 팁을 실시간 제작합니다.',
          points: [
            '원생 행의 [✦ 오답 클리닉] 버튼 한 번으로 개인별 보강 문항지를 생성합니다.',
            '문항 지문뿐 아니라 대칭축 표시 습관 등 현장 강사용 코칭 포인트를 함께 제공합니다.',
            '[학습지 전체 복사] 버튼으로 한글(HWP)·워드·노션 유인물에 바로 붙여넣을 수 있습니다.',
          ],
        },
        {
          src: '/catalog/shot-landing-hero.png',
          url: 'localhost:4321/ — 에듀노드 공식 랜딩 페이지',
          badge: '브랜드 홈 & 신뢰 지표',
          title: '교육 기관 도입 신뢰를 높이는 에디토리얼 랜딩 & 4단계 투어',
          desc: '720회 검증 지표(완수율 98.2%, 무단 행동 0건), 8대 학원·학교 실무 유스케이스, 자주 묻는 질문(FAQ)을 한눈에 안내합니다.',
          points: [
            'Ctrl+K 통합 검색 모달로 전 문서와 스튜디오 기능을 즉시 검색합니다.',
            '라이트/다크 테마 전환 시 깜빡임 없는 디자인 토큰 시스템이 적용되어 있습니다.',
            'Apache 2.0 오픈소스 구조로 교육 기관 보안 심의에 투명하게 대응합니다.',
          ],
        },
        {
          src: '/catalog/shot-docs-dark.png',
          url: 'localhost:4321/docs/trust/privacy — 다크 모드 보안·RBAC 문서',
          badge: '한국어 공식 문서 & 다크 모드',
          title: '설치부터 RBAC 권한 설계·벤치마크까지 완비된 한국어 가이드',
          desc: '야간 원장실·연구실 작업 환경에서도 눈이 편안한 다크 모드와 함께 원장·강사·조교 권한 분리표 및 데이터 보호 원칙을 상세히 문서화했습니다.',
          points: [
            '6개 핵심 문서 섹션과 우측 현재 위치 목차(TOC) 자동 추적을 지원합니다.',
            '지시어 예시 원클릭 복사 버튼으로 설치 직후 5분 만에 실습할 수 있습니다.',
            '프롬프트 인젝션 방어(WhisperBench 0/216) 검증 방법론을 투명하게 공개합니다.',
          ],
        },
      ];

      var galTabs = document.querySelectorAll('.cat-tab-btn[data-shot]');
      var galImg = document.getElementById('gal-img');
      var galUrl = document.getElementById('gal-url');
      var galBadge = document.getElementById('gal-badge');
      var galTitle = document.getElementById('gal-title');
      var galDesc = document.getElementById('gal-desc');
      var galPoints = document.getElementById('gal-points');

      galTabs.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var idx = Number(btn.getAttribute('data-shot'));
          var s = SHOTS[idx];
          if (!s) return;
          galTabs.forEach(function (b, i) {
            b.setAttribute('aria-selected', String(i === idx));
          });
          galImg.src = s.src;
          galImg.setAttribute('data-zoom-src', s.src);
          galImg.alt = s.title;
          galUrl.textContent = s.url;
          galBadge.textContent = s.badge;
          galTitle.textContent = s.title;
          galDesc.textContent = s.desc;
          galPoints.innerHTML = s.points
            .map(function (pt) {
              return '<li>' + pt + '</li>';
            })
            .join('');
        });
      });

      // 4. Interactive ROI & Cost Simulator
      var sStudents = document.getElementById('sim-students');
      var sTeachers = document.getElementById('sim-teachers');
      var sEngine = document.getElementById('sim-engine');

      function updateSimulator() {
        var stCount = Number(sStudents.value);
        var tcCount = Number(sTeachers.value);
        var eng = sEngine.value;

        document.getElementById('sim-students-val').textContent = stCount + '명';
        document.getElementById('sim-teachers-val').textContent = tcCount + '명';

        // Weekly hours saved: ~12h per teacher base + student communication scaling
        var monthlyHours = Math.round(tcCount * 29 + stCount * 0.4);
        document.getElementById('sim-hours-saved').textContent = '월 약 ' + monthlyHours.toLocaleString() + '시간 절약';

        var costKrw = 0;
        if (eng === 'gemini') {
          costKrw = Math.round((stCount * 95 + tcCount * 900) / 100) * 100;
        } else if (eng === 'claude') {
          costKrw = Math.round((stCount * 360 + tcCount * 3200) / 100) * 100;
        } else {
          costKrw = 0;
        }

        document.getElementById('sim-cost').textContent =
          costKrw === 0 ? '₩0 / 월 (폐쇄망 로컬 LLM 무과금)' : '약 ₩' + costKrw.toLocaleString() + ' / 월';

        var ratio = eng === 'local' ? 0.82 : eng === 'claude' ? 0.87 : 0.85;
        document.getElementById('sim-pct').textContent = Math.round(ratio * 100) + '%';
        var circumference = 289;
        var offset = Math.round(circumference * (1 - ratio));
        document.getElementById('sim-donut-arc').setAttribute('stroke-dashoffset', String(offset));
      }

      [sStudents, sTeachers, sEngine].forEach(function (el) {
        if (el) el.addEventListener('input', updateSimulator);
        if (el) el.addEventListener('change', updateSimulator);
      });
      updateSimulator();

      // 5. Lightbox Zoom for all Screenshots & GIFs
      var lightbox = document.getElementById('cat-lightbox');
      var lightboxImg = document.getElementById('cat-lightbox-img');
      var lightboxClose = document.getElementById('cat-lightbox-close');

      document.addEventListener('click', function (e) {
        var zoomEl = e.target.closest('[data-zoom-src]');
        if (zoomEl) {
          lightboxImg.src = zoomEl.getAttribute('data-zoom-src');
          lightboxImg.alt = zoomEl.getAttribute('alt') || '확대 이미지';
          lightbox.hidden = false;
          lightboxClose.focus();
        }
      });
      lightboxClose.addEventListener('click', function () {
        lightbox.hidden = true;
      });
      lightbox.addEventListener('click', function (e) {
        if (e.target === lightbox) lightbox.hidden = true;
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !lightbox.hidden) lightbox.hidden = true;
      });
    })();
  </script>
</Landing>
