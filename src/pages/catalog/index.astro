---
import Landing from '../../layouts/Landing.astro';
import Icon from '../../components/Icon.astro';
import CrossButton from '../../components/CrossButton.astro';
import '../../styles/catalog.css';

const GITHUB = 'https://github.com/Reasonofmoon/edunod';
---
<Landing
  title="에듀노드 (EduNod) 제품 상세 카탈로그 · 아키텍처 · 시각화 · 작동 GIF 브로슈어"
  ogTitle="에듀노드 (EduNod) v2.5 공식 인터랙티브 제품 카탈로그"
  description="실제 화면 스크린샷, 라이브 작동 GIF, 아키텍처 다이어그램, 업무 절감 데이터 시각화 및 인터랙티브 ROI 시뮬레이터로 살펴보는 에듀노드 교육 AI 에이전트 종합 카탈로그."
>
  <a class="lp-top-banner" href="/studio/">
    <span>카탈로그의 모든 화면은 시뮬레이션이 아닌 실제 작동 앱에서 촬영되었습니다 — 지금 스튜디오에서 직접 실행해 보세요.</span>
    <span class="lp-top-banner-cta">라이브 스튜디오 열기 →</span>
  </a>

  <div class="lp-page">
    <header class="lp-header">
      <a class="lp-logo" href="/" aria-label="에듀노드 홈">
        <img class="lockup lockup-invert" src="/img/lockup.svg" alt="EduNod EDU LABS" width="210" height="36" />
      </a>

      <nav class="lp-nav-links" aria-label="주요 메뉴">
        <a href="/">홈</a>
        <a href="/catalog/"><strong>제품 카탈로그</strong></a>
        <a href="/docs/">문서 가이드</a>
        <a href="/docs/how-it-works/benchmarks/">벤치마크</a>
        <a href="/studio/"><strong>스튜디오 체험</strong></a>
      </nav>

      <div class="lp-header-actions">
        <button type="button" class="lp-icon-btn" data-search aria-label="문서 및 기능 통합 검색">
          <Icon name="search" />
          <span>검색</span>
          <kbd>Ctrl K</kbd>
        </button>
        <button type="button" class="lp-icon-btn" data-theme-cycle aria-label="밝은 테마와 어두운 테마 전환">
          <Icon name="sun" />
          <span>테마</span>
        </button>
        <a class="lp-icon-btn" href={GITHUB} target="_blank" rel="noopener noreferrer" aria-label="GitHub 오픈소스 저장소">
          <Icon name="github" />
          <span>GitHub</span>
        </a>
      </div>
    </header>

    <main id="main-content" class="cat-page">
      <!-- 스티키 카탈로그 목차 바 -->
      <nav class="cat-subnav" aria-label="카탈로그 섹션 바로가기">
        <div class="cat-subnav-links">
          <a href="#sec-overview">01. 제품 개요</a>
          <a href="#sec-gifs">02. 실시간 작동 GIF</a>
          <a href="#sec-arch">03. 아키텍처 다이어그램</a>
          <a href="#sec-screens">04. 화면 스샷 &amp; RBAC</a>
          <a href="#sec-viz">05. 데이터 시각화 &amp; ROI</a>
          <a href="#sec-matrix">06. 경쟁 비교표</a>
        </div>
        <div class="cat-subnav-actions">
          <button type="button" class="lp-icon-btn" id="print-catalog-btn" aria-label="카탈로그 브로슈어 PDF 인쇄">
            <span>브로슈어 인쇄 / PDF</span>
          </button>
        </div>
      </nav>

      <!-- 01. 에디토리얼 커버 & 핵심 요약 -->
      <section class="cat-cover" id="sec-overview" aria-labelledby="cat-cover-title">
        <div>
          <span class="cat-vol">EDUNOD PRODUCT MONOGRAPH · VOL. 2.5</span>
          <h1 class="cat-h1" id="cat-cover-title">
            학원 원장 · 강사 · 교사를 위한<br />
            <span class="lp-accent">실제 AI 에이전트</span> 종합 카탈로그
          </h1>
          <p class="cat-lead">
            에듀노드(EduNod)는 원생·학생 민감 데이터와 수납 원장을 내 컴퓨터 안에 격리하면서도, 실제 멀티스텝 도구 호출(Tool Calling)로 출결·미납 알림톡 초안, 오답 클리닉 문항, 상담 브리핑을 완성하고 <strong>인간 최종 승인 게이트(Trust Check)</strong>로 오발송 사고를 원천 차단합니다.
          </p>

          <div class="cat-meta-badges">
            <div class="cat-meta-item">
              <strong>5종 실전 도구 호출</strong>
              <span>원생 조회 · 브리핑 · 알림톡 격리 · 클리닉 출제 · 기억장</span>
            </div>
            <div class="cat-meta-item">
              <strong>무단 외부 발송 0건</strong>
              <span>모든 대외 메시지는 승인 대기함(Trust Queue) 선격리</span>
            </div>
            <div class="cat-meta-item">
              <strong>원장 · 강사 RBAC</strong>
              <span>강사·조교 전환 시 원비 수납액·퇴원 메모 자동 마스킹</span>
            </div>
            <div class="cat-meta-item">
              <strong>멀티 LLM + 폐쇄망</strong>
              <span>Gemini · Claude · OpenAI · 로컬 Ollama(₩0) 지원</span>
            </div>
          </div>

          <div class="lp-cta-row">
            <CrossButton href="/studio/" variant="primary">
              <Icon name="sparkles" /> 실제 AI 스튜디오 바로 열기
            </CrossButton>
            <CrossButton href="/docs/get-started/install-desktop/" variant="secondary">
              원장실 · 교무실 설치 가이드
            </CrossButton>
          </div>
        </div>

        <div class="cat-window">
          <div class="cat-window-bar">
            <span class="cat-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>localhost:4321/studio — 학원 운영자(원장) 모드 실시간 화면</span>
            <span>LIVE</span>
          </div>
          <img
            class="cat-zoom-btn"
            data-zoom-src="/catalog/shot-director-briefing.png"
            src="/catalog/shot-director-briefing.png"
            alt="에듀노드 스튜디오 학원 운영자(원장) 모드 실시간 대시보드 스크린샷"
            width="1440"
            height="900"
          />
        </div>
      </section>

      <!-- 02. 실제 녹화된 작동 애니메이션 GIF 쇼케이스 -->
      <section class="cat-sec" id="sec-gifs" aria-labelledby="h-gifs">
        <div class="cat-sec-head">
          <span class="cat-sec-num">SECTION 02 · LIVE ANIMATED WORKFLOWS (GIF)</span>
          <h2 id="h-gifs">실제 작동 녹화 GIF로 보는 핵심 워크플로우</h2>
          <p>
            모형 시안이 아니라 실제 가동 중인 에듀노드 서버에서 LLM 도구 호출과 권한 마스킹이 실시간으로 실행되는 모습을 그대로 녹화한 워크플로우 GIF입니다. (이미지를 클릭하면 크게 확대됩니다.)
          </p>
        </div>

        <div class="cat-gif-grid">
          <article class="cat-gif-card">
            <div class="cat-window">
              <div class="cat-window-bar">
                <span class="cat-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span>WORKFLOW GIF #1 · 실제 AI 도구 호출 &amp; Trust Check 결재</span>
                <span>GIF</span>
              </div>
              <img
                class="cat-zoom-btn"
                data-zoom-src="/catalog/demo-live-agent-flow.gif"
                src="/catalog/demo-live-agent-flow.gif"
                alt="원장이 미등원 안심 확인 알림톡 초안 작성을 지시하자 실제 Gemini 에이전트가 원생 기록을 조회해 승인 대기함에 등록하고 원장이 최종 승인하는 작동 GIF"
                width="1120"
                height="700"
              />
            </div>
            <div class="cat-gif-caption">
              <h3>① 자연어 지시 → 실제 AI 도구 실행 → 승인 대기함 결재</h3>
              <p>
                원장님이 “미등원 중인 정서윤 학부모님께 안심 확인 알림톡 초안 만들어줘”라고 입력하면, 백엔드 에이전트가 원생 DB를 조회한 뒤 <code>propose_external_message</code> 도구를 호출해 즉시 발송 대신 <strong>[2. 최종 승인 대기함]</strong>에 초안을 격리 등록합니다.
              </p>
              <div class="cat-step-pills">
                <span>1. 출결 브리핑 확인</span>
                <span>2. 자연어 업무 지시</span>
                <span>3. Gemini 2.5 도구 호출</span>
                <span>4. 승인 대기함 검토·발송</span>
              </div>
            </div>
          </article>

          <article class="cat-gif-card">
            <div class="cat-window">
              <div class="cat-window-bar">
                <span class="cat-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span>WORKFLOW GIF #2 · 수납 RBAC 마스킹 &amp; 강사 오답 클리닉</span>
                <span>GIF</span>
              </div>
              <img
                class="cat-zoom-btn"
                data-zoom-src="/catalog/demo-rbac-clinic-flow.gif"
                src="/catalog/demo-rbac-clinic-flow.gif"
                alt="원장 권한에서 강사·조교 권한으로 바꾸자 원비 미납액이 즉시 비공개 마스킹되고 학원 강사 클리닉 모드와 다크 테마로 전환되는 작동 GIF"
                width="1120"
                height="700"
              />
            </div>
            <div class="cat-gif-caption">
              <h3>② 원장·강사 수납 권한 분리(RBAC) &amp; 오답 클리닉 전환</h3>
              <p>
                상단 권한을 <strong>강사 · 조교 TA</strong>로 바꾸는 즉시 원비 미납 금액(<code>380,000원</code>)과 퇴원 위험 메모가 <code>🔒 원장 전용</code>으로 가려지며, <strong>학원 강사 모드</strong>에서는 커트라인 미달 원생용 쌍둥이 오답 클리닉 문항과 지도 팁을 바로 활용합니다.
              </p>
              <div class="cat-step-pills">
                <span>1. 원장 수납 원장 열람</span>
                <span>2. 강사·조교 전환 즉시 마스킹</span>
                <span>3. 강사 오답 클리닉 문항지</span>
                <span>4. 다크 모드 지원</span>
              </div>
            </div>
          </article>
        </div>
      </section>

      <!-- 03. 인터랙티브 아키텍처 & 시퀀스 다이어그램 -->
      <section class="cat-sec" id="sec-arch" aria-labelledby="h-arch">
        <div class="cat-sec-head">
          <span class="cat-sec-num">SECTION 03 · ARCHITECTURE &amp; TRUST DIAGRAM</span>
          <h2 id="h-arch">데이터 격리 · RBAC · 승인 게이트 통합 아키텍처</h2>
          <p>
            다이어그램의 각 구성 블록(①~⑤)을 클릭하면 해당 계층이 원생·학생 개인정보와 오발송 위험을 어떻게 통제하는지 상세 설계가 아래 인스펙터에 표시됩니다.
          </p>
        </div>

        <div class="cat-arch-box">
          <svg
            class="cat-arch-svg"
            viewBox="0 0 1120 340"
            role="img"
            aria-label="에듀노드 5계층 보안 및 도구 호출 아키텍처 다이어그램"
          >
            <defs>
              <marker id="arr-green" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M 0 1 L 10 5 L 0 9 z" fill="#1f6f54" />
              </marker>
              <marker id="arr-warm" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M 0 1 L 10 5 L 0 9 z" fill="#c75c24" />
              </marker>
            </defs>

            <!-- 로컬 안전 경계선 -->
            <rect x="16" y="16" width="664" height="308" rx="18" fill="#1f6f54" fill-opacity="0.06" stroke="#1f6f54" stroke-dasharray="6 5" stroke-width="1.8" />
            <text x="36" y="44" font-size="13" font-weight="800" fill="#1f6f54">원장실 · 교무실 로컬 신뢰 경계 (원본 DB 및 API 시크릿 외부 유출 0바이트)</text>

            <!-- Node 1: Data Sources -->
            <g class="cat-arch-node" data-arch="0" tabindex="0" role="button" aria-label="1계층: 학원 및 학교 현장 채널">
              <rect x="36" y="72" width="184" height="224" rx="14" fill="#ffffff" stroke="#1f6f54" stroke-width="2" />
              <rect x="36" y="72" width="184" height="38" rx="14" fill="#1f6f54" />
              <text x="128" y="96" text-anchor="middle" font-size="13" font-weight="800" fill="#ffffff">① 현장 입력 채널</text>
              <text x="54" y="136" font-size="12.5" font-weight="700" fill="#18221e">• 등·하원 출결 키오스크</text>
              <text x="54" y="164" font-size="12.5" font-weight="700" fill="#18221e">• 결제선생 · 수납 시트</text>
              <text x="54" y="192" font-size="12.5" font-weight="700" fill="#18221e">• 주간평가 · 내신 기출</text>
              <text x="54" y="220" font-size="12.5" font-weight="700" fill="#18221e">• Classroom · Canvas</text>
              <text x="54" y="248" font-size="12.5" font-weight="700" fill="#18221e">• 학사·상담 일정 캘린더</text>
              <text x="128" y="280" text-anchor="middle" font-size="11" fill="#52605a">[클릭하여 상세 보기]</text>
            </g>

            <!-- Arrow 1 -> 2 -->
            <line x1="220" y1="184" x2="258" y2="184" stroke="#1f6f54" stroke-width="2.5" marker-end="url(#arr-green)" />

            <!-- Node 2: Local Workspace + RBAC -->
            <g class="cat-arch-node" data-arch="1" tabindex="0" role="button" aria-label="2계층: 로컬 워크스페이스 및 RBAC 필터">
              <rect x="264" y="72" width="192" height="224" rx="14" fill="#ffffff" stroke="#1f6f54" stroke-width="2" />
              <rect x="264" y="72" width="192" height="38" rx="14" fill="#1f6f54" />
              <text x="360" y="96" text-anchor="middle" font-size="13" font-weight="800" fill="#ffffff">② 로컬 DB &amp; RBAC</text>
              <text x="282" y="138" font-size="12.5" font-weight="700" fill="#18221e">• 원생·학생 명렬 격리</text>
              <text x="282" y="166" font-size="12.5" font-weight="700" fill="#18221e">• 강사/TA 수납액 마스킹</text>
              <text x="282" y="194" font-size="12.5" font-weight="700" fill="#18221e">• 투명 기억장 (즉시 파기)</text>
              <text x="282" y="222" font-size="12.5" font-weight="700" fill="#18221e">• 주민번호 정규식 치환</text>
              <text x="282" y="250" font-size="12.5" font-weight="700" fill="#18221e">• 실시간 감사 로그 기록</text>
              <text x="360" y="280" text-anchor="middle" font-size="11" fill="#52605a">[클릭하여 상세 보기]</text>
            </g>

            <!-- Arrow 2 <-> 4 (Trust Gate) & 2 <-> 3 (LLM) -->
            <line x1="456" y1="145" x2="706" y2="145" stroke="#1f6f54" stroke-width="2.5" marker-end="url(#arr-green)" />
            <line x1="706" y1="172" x2="456" y2="172" stroke="#1f6f54" stroke-width="2" stroke-dasharray="5 4" marker-end="url(#arr-green)" />

            <!-- Node 4: Trust Check Gate (Inside Local Boundary!) -->
            <g class="cat-arch-node" data-arch="3" tabindex="0" role="button" aria-label="4계층: 독립 승인 게이트 Trust Check">
              <rect x="484" y="196" width="180" height="100" rx="14" fill="#fff7f2" stroke="#c75c24" stroke-width="2.4" />
              <text x="574" y="224" text-anchor="middle" font-size="13" font-weight="800" fill="#c75c24">④ Trust Check 게이트</text>
              <text x="574" y="248" text-anchor="middle" font-size="12" font-weight="700" fill="#18221e">모든 발송 도구 즉시 가로채기</text>
              <text x="574" y="268" text-anchor="middle" font-size="11.5" fill="#52605a">승인 대기함 격리 · 무단발송 0%</text>
              <text x="574" y="286" text-anchor="middle" font-size="10.5" fill="#c75c24">[클릭하여 상세 보기]</text>
            </g>

            <!-- Node 3: Multi-LLM Engine -->
            <g class="cat-arch-node" data-arch="2" tabindex="0" role="button" aria-label="3계층: 멀티 LLM 도구 호출 런타임">
              <rect x="712" y="42" width="188" height="148" rx="14" fill="#ffffff" stroke="#2c6ea3" stroke-width="2" />
              <rect x="712" y="42" width="188" height="36" rx="14" fill="#2c6ea3" />
              <text x="806" y="65" text-anchor="middle" font-size="13" font-weight="800" fill="#ffffff">③ 멀티 AI 추론 엔진</text>
              <text x="728" y="104" font-size="12.5" font-weight="700" fill="#18221e">• Gemini 2.5 Flash</text>
              <text x="728" y="128" font-size="12.5" font-weight="700" fill="#18221e">• Claude Sonnet 4</text>
              <text x="728" y="152" font-size="12.5" font-weight="700" fill="#18221e">• 폐쇄망 Ollama (₩0)</text>
              <text x="806" y="176" text-anchor="middle" font-size="11" fill="#2c6ea3">자동 페일오버 &amp; 예산 상한</text>
            </g>

            <!-- Arrow 4 -> 5 -->
            <line x1="664" y1="246" x2="914" y2="246" stroke="#c75c24" stroke-width="2.5" marker-end="url(#arr-warm)" />

            <!-- Node 5: Human Final Approval & Delivery -->
            <g class="cat-arch-node" data-arch="4" tabindex="0" role="button" aria-label="5계층: 원장 및 교사 최종 승인 후 안전 전송">
              <rect x="920" y="178" width="180" height="136" rx="14" fill="#1f6f54" />
              <text x="1010" y="210" text-anchor="middle" font-size="13.5" font-weight="800" fill="#ffffff">⑤ 원장 · 교사 최종 승인</text>
              <text x="1010" y="236" text-anchor="middle" font-size="12" fill="#e6f4ee">초안 문구 직접 수정 가능</text>
              <text x="1010" y="258" text-anchor="middle" font-size="12" fill="#e6f4ee">원장 결재 후 알림톡·공지 발송</text>
              <text x="1010" y="286" text-anchor="middle" font-size="11" font-weight="700" fill="#ffffff">[클릭하여 상세 보기]</text>
            </g>
          </svg>

