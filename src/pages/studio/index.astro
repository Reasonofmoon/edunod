        // Tab Switching
        var navBtns = document.querySelectorAll('.st-nav-btn[data-view]');
        var panels = {
          briefings: document.getElementById('panel-briefings'),
          approvals: document.getElementById('panel-approvals'),
          roster: document.getElementById('panel-roster'),
          chat: document.getElementById('panel-chat'),
          memory: document.getElementById('panel-memory'),
        };
        function switchView(view) {
          navBtns.forEach(function (b) {
            b.setAttribute('aria-selected', String(b.getAttribute('data-view') === view));
          });
          Object.keys(panels).forEach(function (k) {
            panels[k].hidden = k !== view;
          });
        }
        navBtns.forEach(function (b) {
          b.addEventListener('click', function () {
            switchView(b.getAttribute('data-view'));
          });
        });

        // Core Live AI Agent Runner (/api/agent/run with graceful offline fallback)
        async function executeRealAgentInstruction(promptText, opts) {
          opts = opts || {};
          if (isAgentBusy) {
            window.showEduToast('현재 AI 에이전트가 이전 지시를 처리 중입니다.');
            return;
          }
          var cur = state[currentPreset];
          if (!opts.silentUserBubble) {
            cur.chat.push({ who: 'user', text: promptText });
          }
          isAgentBusy = true;
          setBusyButtons(true);
          renderChat();

          try {
            var res = await fetch('/api/agent/run', {
              method: 'POST',
              headers: buildAgentHeaders(),
              body: JSON.stringify({
                preset: currentPreset,
                role: currentRole,
                preferredProvider: currentModel,
                userMessage: promptText,
                history: cur.chat.slice(-8),
                workspace: {
                  roster: cur.roster,
                  memories: cur.memories,
                  schedules: cur.schedules,
                },
              }),
            });

            var data = await res.json();
            if (!res.ok || !data.ok) {
              throw new Error(data.error || 'Agent HTTP ' + res.status);
            }

            var eff = data.effects || {};
            (eff.briefings || []).forEach(function (b) {
              cur.briefings.unshift(b);
            });
            (eff.approvals || []).forEach(function (a) {
              cur.approvals.unshift(a);
            });
            (eff.worksheets || []).forEach(function (w) {
              cur.worksheets.unshift(w);
            });
            (eff.memories || []).forEach(function (m) {
              cur.memories.unshift(m);
            });
            (eff.audits || []).forEach(function (au) {
              cur.audits.unshift({ time: nowTime(), msg: au });
            });
            if (cur.audits.length > 18) cur.audits = cur.audits.slice(0, 18);

            chargeTokens(data.costKrw || 25);

            cur.chat.push({
              who: 'agent',
              text: data.reply,
              meta: {
                provider: data.provider,
                tokens: data.tokens || 0,
                costKrw: data.costKrw || 0,
                briefings: (eff.briefings || []).length,
                approvals: (eff.approvals || []).length,
                worksheets: (eff.worksheets || []).length,
              },
            });

            saveState();
            isAgentBusy = false;
            setBusyButtons(false);
            renderAll();

            if (opts.onSuccessToast) {
              window.showEduToast(opts.onSuccessToast);
            } else if ((eff.approvals || []).length > 0) {
              window.showEduToast('AI가 작성한 초안이 [2. 최종 승인 대기함]에 안전하게 격리 등록되었습니다.');
            } else if ((eff.worksheets || []).length > 0) {
              window.showEduToast('AI 맞춤 오답 클리닉 문항지가 생성되었습니다!');
            } else if ((eff.briefings || []).length > 0) {
              window.showEduToast('AI 실시간 브리핑 카드가 상단에 생성되었습니다!');
            }
          } catch (err) {
            // Graceful local fallback if static build or local Ollama not started
            var fallbackMsg =
              '[로컬 폴백 안내: ' +
              (err.message || '서버 미연결') +
              '] 로컬 원생 데이터를 기반으로 초안을 승인 대기함에 임시 생성했습니다.';
            if (/알림톡|초안|안내|발송|문자|공지|리포트/.test(promptText)) {
              cur.approvals.unshift({
                id: 'ap_fb_' + Date.now(),
                app: currentPreset.indexOf('academy') === 0 ? '학원 알림톡 (로컬 폴백)' : '기관 소통 채널',
                scope: '지시 기반 생성 초안',
                title: '[초안] ' + promptText.slice(0, 34),
                draft:
                  '안녕하세요 학부모님, 에듀노드입니다. 요청하신 "' +
                  promptText +
                  '" 관련 안내 문구 초안입니다. 세부 일정을 확인 후 발송 승인해 주세요.',
              });
            }
            cur.chat.push({
              who: 'agent',
              text: fallbackMsg,
              meta: { provider: '로컬 오프라인 폴백', tokens: 0, costKrw: 0, approvals: 1, briefings: 0, worksheets: 0 },
            });
            addAudit('[폴백 전환] ' + (err.message || '오프라인 모드 응답'));
            isAgentBusy = false;
            setBusyButtons(false);
            saveState();
            renderAll();
            window.showEduToast('에이전트 연결을 확인해 주세요: ' + (err.message || '오류'));
          }
        }

