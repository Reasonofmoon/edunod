            geminiKey: document.getElementById('cfg-gemini-key').value.trim(),
            anthropicKey: document.getElementById('cfg-anthropic-key').value.trim(),
            localUrl: document.getElementById('cfg-local-url').value.trim(),
            localModel: document.getElementById('cfg-local-model').value.trim(),
          });
          closeCfgModal();
          checkAgentStatus();
          window.showEduToast('AI 에이전트 연결 설정이 현재 세션에 적용되었습니다.');
        });

        document.getElementById('clear-agent-cfg').addEventListener('click', function () {
          saveSessionCfg({ geminiKey: '', anthropicKey: '', localUrl: '', localModel: '' });
          document.getElementById('cfg-gemini-key').value = '';
          document.getElementById('cfg-anthropic-key').value = '';
          document.getElementById('cfg-local-url').value = '';
          document.getElementById('cfg-local-model').value = '';
          checkAgentStatus();
          window.showEduToast('세션 입력값이 초기화되어 서버 기본 키 설정으로 복귀했습니다.');
        });

        document.getElementById('reset-demo-btn').addEventListener('click', function () {
          state = clone(PRESETS);
          saveState();
          renderAll();
          window.showEduToast('스튜디오 실습 데이터가 초기 상태로 복원되었습니다.');
        });

        renderAll();
        checkAgentStatus();
      })();
    </script>
  </body>
</html>
