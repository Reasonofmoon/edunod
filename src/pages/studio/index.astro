        function renderChat() {
          var cur = state[currentPreset];
          var log = document.getElementById('chat-log');
          var html = cur.chat
            .map(function (m) {
              var metaHtml = '';
              if (m.meta) {
                var jumpBtns = '';
                if (m.meta.approvals > 0) {
                  jumpBtns +=
                    ' <button type="button" class="st-btn st-btn-sm" data-jump-view="approvals">승인 대기함 보기 (' +
                    m.meta.approvals +
                    '건) →</button>';
                }
                if (m.meta.briefings > 0) {
                  jumpBtns +=
                    ' <button type="button" class="st-btn st-btn-sm" data-jump-view="briefings">새 브리핑 보기 →</button>';
                }
                if (m.meta.worksheets > 0) {
                  jumpBtns +=
                    ' <button type="button" class="st-btn st-btn-sm" data-jump-view="roster">생성된 클리닉 문항 보기 →</button>';
                }
                metaHtml =
                  '<div class="st-msg-meta">' +
                  '<span>실행 엔진: <strong>' +
                  esc(m.meta.provider) +
                  '</strong></span>' +
                  (m.meta.tokens ? '<span>· 토큰: ' + m.meta.tokens.toLocaleString() + '</span>' : '') +
                  (m.meta.costKrw != null ? '<span>· 비용: ₩' + m.meta.costKrw + '</span>' : '') +
                  jumpBtns +
                  '</div>';
              }
              return (
                '<div class="st-msg ' +
                (m.who === 'user' ? 'st-msg-user' : 'st-msg-agent') +
                '">' +
                esc(m.text) +
                metaHtml +
                '</div>'
              );
            })
            .join('');

          if (isAgentBusy) {
            html +=
              '<div class="st-msg-thinking">✦ 실제 AI 에이전트가 로컬 원생/학생 기록을 조회하고 도구를 실행 중입니다…</div>';
          }
          log.innerHTML = html;
          log.scrollTop = log.scrollHeight;
        }

