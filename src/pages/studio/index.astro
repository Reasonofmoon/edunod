        var STORAGE_KEY = 'edunod-studio-state-v2';
        var SESSION_CFG_KEY = 'edunod-agent-session-cfg';
        var currentPreset = 'academy_director';
        var currentRole = 'owner';
        var currentModel = 'auto';
        var isAgentBusy = false;
        var serverAgentStatus = { live: false, defaultProvider: 'none', providers: {} };
        var state = loadState();

        function clone(obj) {
          return JSON.parse(JSON.stringify(obj));
        }

        function loadState() {
          try {
            var raw = localStorage.getItem(STORAGE_KEY);
            if (raw) {
              var parsed = JSON.parse(raw);
              if (parsed && parsed.academy_director && parsed.academy_instructor) return parsed;
            }
          } catch (e) {}
          return clone(PRESETS);
        }

        function saveState() {
          try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
          } catch (e) {}
        }

        function getSessionCfg() {
          try {
            var raw = sessionStorage.getItem(SESSION_CFG_KEY);
            if (raw) return JSON.parse(raw);
          } catch (e) {}
          return { geminiKey: '', anthropicKey: '', localUrl: '', localModel: '' };
        }

        function saveSessionCfg(cfg) {
          try {
            sessionStorage.setItem(SESSION_CFG_KEY, JSON.stringify(cfg));
          } catch (e) {}
        }

        function buildAgentHeaders() {
          var cfg = getSessionCfg();
          var h = { 'Content-Type': 'application/json' };
          if (cfg.geminiKey) h['x-edunod-gemini-key'] = cfg.geminiKey;
          if (cfg.anthropicKey) h['x-edunod-anthropic-key'] = cfg.anthropicKey;
          if (cfg.localUrl) h['x-edunod-local-url'] = cfg.localUrl;
          if (cfg.localModel) h['x-edunod-local-model'] = cfg.localModel;
          return h;
        }

        async function checkAgentStatus() {
          var badge = document.getElementById('node-status-badge');
          var modalTxt = document.getElementById('agent-modal-status-text');
          var bannerDesc = document.getElementById('chat-agent-desc');
          try {
            var res = await fetch('/api/agent/status', { headers: buildAgentHeaders() });
            if (!res.ok) throw new Error('status http ' + res.status);
            var data = await res.json();
            serverAgentStatus = data;
            if (data.live) {
              var activeList = [];
              if (data.providers.gemini) activeList.push('Gemini');
              if (data.providers.anthropic) activeList.push('Claude');
              if (data.providers.openai) activeList.push('OpenAI');
              if (data.providers.local) activeList.push('로컬 LLM');
              badge.classList.remove('is-offline');
              badge.textContent = '실제 AI 에이전트 가동 중 · ' + activeList.join(' / ');
              modalTxt.innerHTML =
                '<strong style="color:var(--brand);">✓ 실시간 AI 서버 연결됨:</strong> 현재 서버에서 <strong>' +
                esc(activeList.join(', ')) +
                '</strong> 도구 호출 엔진이 즉시 사용 가능합니다(API 키는 서버에서만 안전하게 처리됨).';
              bannerDesc.innerHTML =
                '<strong>실시간 AI 에이전트 활성 (' +
                esc(activeList.join(' · ')) +
                '):</strong> 지시를 보내면 실제 모델이 로컬 원생 DB 조회·브리핑·알림톡 초안·클리닉 문항 생성 도구를 직접 실행합니다.';
            } else {
              badge.classList.add('is-offline');
              badge.textContent = '로컬 시뮬레이션 대기 (API 키 미설정)';
              modalTxt.textContent =
                '현재 연결된 모델 키가 없습니다. 아래에 Gemini/Claude API 키 또는 로컬 Ollama 주소를 입력하면 실제 AI 에이전트가 활성화됩니다.';
            }
          } catch (err) {
            badge.classList.add('is-offline');
            badge.textContent = '오프라인 데모 모드 (정적 호스팅)';
            modalTxt.textContent =
              '정적 미리보기 환경입니다. `npm run dev` 또는 `npm start` 서버로 실행하면 실시간 AI 에이전트 백엔드(/api/agent/run)가 활성화됩니다.';
          }
        }

        function nowTime() {
          var d = new Date();
          return (
            String(d.getHours()).padStart(2, '0') +
            ':' +
            String(d.getMinutes()).padStart(2, '0') +
            ':' +
            String(d.getSeconds()).padStart(2, '0')
          );
        }

        function esc(s) {
          return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
          });
        }

        function addAudit(msg) {
          var cur = state[currentPreset];
          cur.audits.unshift({ time: nowTime(), msg: msg });
          if (cur.audits.length > 18) cur.audits.pop();
          saveState();
          renderAudits();
        }

        function chargeTokens(krw) {
          var cur = state[currentPreset];
          if (currentModel === 'local') {
            renderBudget();
            return;
          }
          cur.budgetUsed = Math.min(cur.budgetMax, cur.budgetUsed + krw);
          saveState();
          renderBudget();
        }

        function renderBudget() {
          var cur = state[currentPreset];
          var pct = Math.min(100, Math.round((cur.budgetUsed / cur.budgetMax) * 1000) / 10);
          document.getElementById('budget-label').textContent =
            '₩' + cur.budgetUsed.toLocaleString() + ' / ₩' + cur.budgetMax.toLocaleString();
          document.getElementById('budget-bar').style.width = pct + '%';
          document.getElementById('budget-note').textContent =
            currentModel === 'local'
              ? '폐쇄망 로컬 모델 활성 — 추가 API 과금 ₩0'
              : '한도의 ' + Math.round(pct) + '% 사용 중 · 100% 도달 시 자동 차단';
        }

        function renderSidebarChannels() {
          var cur = state[currentPreset];
          var box = document.getElementById('connected-apps-list');
          box.innerHTML = (cur.channels || [])
            .map(function (c) {
              return '<span>' + esc(c) + '</span>';
            })
            .join('');
        }

        function renderKpis() {
          var cur = state[currentPreset];
          var strip = document.getElementById('kpi-strip');
          strip.innerHTML = (cur.kpis || [])
            .map(function (k) {
              var maskedVal =
                currentRole === 'ta' && /수납|원비/.test(k.label) ? '🔒 원장 전용' : k.val;
