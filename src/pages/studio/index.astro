                currentRole === 'ta' && /수납|원비/.test(k.label) ? '강사·조교 권한 비공개' : k.sub;
              return (
                '<div class="st-kpi">' +
                '<span class="st-kpi-label">' +
                esc(k.label) +
                '</span>' +
                '<strong class="st-kpi-val">' +
                esc(maskedVal) +
                '</strong>' +
                '<span class="st-kpi-sub">' +
                esc(maskedSub) +
                '</span>' +
                '</div>'
              );
            })
            .join('');
        }

        function renderPrompts() {
          var cur = state[currentPreset];
