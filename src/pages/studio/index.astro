                '">' +
                esc(a.draft) +
                '</textarea>' +
                '<div class="st-card-actions">' +
                '<button type="button" class="st-btn st-btn-primary" data-approve="' +
                idx +
                '">' +
                approveBtnLabel +
                '</button>' +
                '<button type="button" class="st-btn st-btn-danger" data-reject="' +
