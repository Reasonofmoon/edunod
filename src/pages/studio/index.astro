            return;
          }
          var approveBtnLabel =
            currentRole === 'ta' ? '문구 검토 완료 · 원장/담임 결재 상신' : '검토 완료 · 최종 발송 승인';
          list.innerHTML = cur.approvals
            .map(function (a, idx) {
              return (
                '<article class="st-card">' +
                '<div class="st-card-top"><span class="st-tag st-tag-warn">승인 필요 · ' +
                esc(a.app) +
                '</span><span style="font-size:12.5px;color:var(--ink-muted);font-weight:600;">' +
                esc(a.scope) +
