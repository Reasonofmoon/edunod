---
import Landing from '../layouts/Landing.astro';
import Icon from '../components/Icon.astro';
import CrossButton from '../components/CrossButton.astro';

const GITHUB = 'https://github.com/n8n-io/nod';
const local = {
  studio: '/studio/',
  docs: '/docs/',
  install: '/docs/get-started/install-desktop/',
  apps: '/docs/connect/apps/',
  models: '/docs/connect/models/',
  privacy: '/docs/trust/privacy/',
  benchmarks: '/docs/how-it-works/benchmarks/',
};

const stats = [
  {
    num: '98.2%',
    title: '교무·수업 심부름을 끝까지 완수하나요?',
    href: `${local.benchmarks}#results-at-a-glance`,
    text: '모의 LMS·캘린더·문서함에서 240개 교육 시나리오를 각 3회씩 총 720회 반복 실행한 결과입니다.',
  },
  {
    num: '94.1%',
    title: '학기 초에 알려준 원칙을 기억하나요?',
    href: `${local.benchmarks}#longmemeval-recall`,
    text: '새 대화창에서 이전 상담 메모와 수업 루브릭 500문항을 물었을 때의 회상 정확도입니다(LongMemEval-S).',
  },
  {
    num: '0 / 216',
    title: '악성 메일·과제가 허위 기억을 심을 수 있나요?',
    href: `${local.benchmarks}#whisperbench-poisoning`,
    text: '108개 공격 이메일을 두 가지 방식으로 주입해도 기억장 오염이 0건으로 차단되었습니다(WhisperBench).',
  },
];

const memory = [
  {
    pill: '모든 메모가 투명하게 보입니다',
    text: '“김하늘 학생: 발표 긴장도가 높아 모둠 내 서기·자료조사 역할 선호 (4/2 상담)”처럼 출처와 날짜를 함께 확인하고 언제든 수정·삭제합니다.',
  },
  {
    pill: '선생님의 안내문 어조를 배웁니다',
    text: '학생 실명이나 주민번호를 저장하지 않고도 평소 가정통신문과 강의 공지의 정중하고 명확한 문체를 학습해 초안을 작성합니다.',
  },
  {
    pill: '한 번 바뀐 학사 일정은 즉시 반영합니다',
    text: '“문학 수행평가 마감이 다음 주 수요일로 연기됐어”라고 한 번만 말하면 이후 모든 브리핑과 독려 초안에 새 일정이 적용됩니다.',
  },
  {
    pill: '반복되는 교무 절차를 스스로 익힙니다',
    text: '매주 월요일 LMS 미제출자 확인 후 개별 안내 초안을 묶어 두는 절차를 기억하고 학기 내내 재사용합니다.',
  },
];

const upgrades = [
  {
    icon: 'cloud',
    lead: '교무실·학과 상시 캠퍼스 노드 기본 지원.',
    rest: '퇴근 후 개인 노트북을 덮어도 교내 미니PC·학과 서버에서 아침 브리핑과 마감 점검이 멈추지 않습니다.',
  },
  {
    icon: 'team',
    lead: '부담임·교과전담·수업 조교(TA) 역할별 협업.',
    rest: '1인 단독 에이전트의 한계를 넘어, 민감 상담은 담임만 열람하고 최종 발송 승인은 교수·담임이 통제합니다.',
  },
  {
    icon: 'shield',
    lead: '월간 학교 예산 가드레일 & 폐쇄망 로컬 LLM.',
    rest: '예산 한도 도달 시 과금을 자동 차단하며, 외부 전송이 전혀 없는 교내 로컬 모델과 교육청 게이트웨이를 지원합니다.',
  },
  {
    icon: 'code',
    lead: '100% 오픈소스(Apache 2.0) 투명성.',
    rest: '학교 정보보안 심의에서 모든 코드와 승인 검증 로직을 직접 감사하고 기관 환경에 맞게 확장할 수 있습니다.',
  },
] as const;

const usecases = [
  {
    cat: '학원 원장 · 출결·수납 운영',
    title: '등·하원 미등원 케어 & 정중한 원비 안내 알림톡',
    text: '수업 시작 후 미등원 원생을 즉시 포착하고, 미납 D+5 대상 학부모님께 최근 성취 칭찬을 곁들인 정중한 납부 안내 초안을 올립니다.',
    color: 'var(--brand)',
  },
  {
    cat: '학원 강사 · 오답 클리닉',
    title: '커트라인 미달 원생 맞춤 클리닉 문항 & 일일 리포트',
    text: '주간 테스트 오답 단원을 바탕으로 쌍둥이 보강 문항·해설지를 실시간 생성하고 반별 수업·과제 피드백 알림톡 초안을 준비합니다.',
    color: 'var(--accent)',
  },
  {
    cat: '입학 상담 · 휴퇴원 예방',
    title: '신규 레벨테스트 상담 브리핑 & 퇴원 위험군 감지',
    text: '진단평가 결과와 추천 반 커리큘럼을 1페이지 브리핑으로 묶고, 지각·성적 하락이 겹친 주의 원생을 원장님께 조기 보고합니다.',
    color: '#1e6b7b',
  },
  {
    cat: '원장 · 강사 · 조교 권한 분리',
    title: '원비 수납 원장 비공개 마스킹(RBAC) & 결재 상신',
    text: '강사와 조교 화면에서는 원비 미납액·매출 정보를 자동 가림 처리하고, 작성한 단체 알림톡은 원장 승인 대기함으로 상신합니다.',
    color: '#8f4f2b',
  },
  {
    cat: '초·중·고 상담 · 세특',
    title: '상담 10분 전, 완벽한 1페이지 브리핑',
    text: '지난 학기 상담 메모, 최근 수행평가 제출 현황, 사전 질문지를 묶어 상담 핵심 질문까지 정리합니다.',
    color: '#2c6ea3',
  },
  {
    cat: 'LMS · 과제 운영',
    title: '미제출자 집계부터 개별 독려 초안까지',
    text: 'Google Classroom·Canvas에서 마감 임박 미제출 학생을 추려 정중한 독려 메시지를 승인 대기함에 올립니다.',
    color: '#7a52a8',
  },
  {
    cat: '대학 강의 · TA 협업',
    title: '강의계획서 기반 질의응답 초안 자동화',
    text: '시험 범위·과제 규정을 묻는 반복 질문에 강의계획서 조항을 인용한 정확한 답변 초안을 준비합니다.',
    color: '#b87a14',
  },
  {
    cat: '교무·학과 행정',
    title: '놓치기 쉬운 교육청 공문·내신 시험범위 정리',
    text: '인근 학교별 기말고사 시험범위 비교표부터 주요 교원 연수 공문 마감일까지 핵심만 추려 알립니다.',
    color: '#2b7a69',
  },
];

const faqs: { q: string; a: string }[] = [
  {
    q: '학생 개인정보나 상담 기록이 외부 AI 학습에 사용되지 않나요?',
    a: `네, 절대 사용되지 않습니다. 모든 상담 DB와 학급 기억장은 선생님의 PC 또는 학교 내부 서버에만 로컬 저장됩니다. 무학습 보장(Zero Data Retention) 기관용 API나 <a href="${local.models}#local-and-gateway-servers">폐쇄망 교내 로컬 모델</a>을 연결하면 외부 유출 가능성을 원천 차단할 수 있습니다. 자세한 구조는 <a href="${local.privacy}">학생 개인정보 보호 원칙</a>에서 확인하세요.`,
  },
  {
    q: 'AI가 실수로 학부모님께 잘못된 메시지를 바로 보낼 수도 있나요?',
    a: `아니요. 에듀노드의 모든 외부 발송·공지·일정 수정은 <strong>교사 승인 게이트(Trust Check)</strong>를 통과해야 합니다. 에듀노드는 승인 대기함에 초안만 올리며, 선생님이 직접 문구를 확인하고 [발송 승인]을 눌러야만 전송됩니다.`,
  },
  {
    q: '설치 없이 지금 바로 화면과 기능을 써볼 수 있나요?',
    a: `물론입니다! 브라우저에서 바로 동작하는 <a href="${local.studio}">에듀노드 인터랙티브 스튜디오</a>에서 초·중·고 담임 모드와 대학 교수 모드를 전환하며 브리핑 생성, 승인 대기함 검토, 학급 기억장 관리를 직접 실습해 보실 수 있습니다.`,
  },
  {
    q: '퇴근할 때 노트북을 덮으면 아침 브리핑이나 마감 점검은 멈추나요?',
    a: `개인 노트북 단독 모드에서는 절전 중 대기하다가 노트북을 열면 재개됩니다. 24시간 상시 자동화가 필요할 때는 교무실 미니PC나 학과 서버에 <a href="${local.install}#always-on-campus-node">캠퍼스 상시 노드</a>를 띄워 두면 노트북이 꺼져 있어도 아침 7시 브리핑이 정확히 준비됩니다.`,
  },
  {
    q: '부담임 선생님이나 수업 조교(TA)와 함께 사용할 수 있나요?',
    a: `네. 기존 개인용 에이전트의 단일 소유자 한계를 개선하여 <a href="${local.privacy}#co-teacher-roles">3단계 역할 권한 분리</a>를 지원합니다. 조교는 과제 현황 열람과 초안 상신만 수행하고, 민감 상담 열람과 최종 발송 승인은 담임·담당 교수만 하도록 제한할 수 있습니다.`,
  },
  {
    q: '비용은 얼마이며 학교 예산 한도를 넘지 않게 막을 수 있나요?',
    a: `에듀노드 앱 자체는 무료 오픈소스(Apache 2.0)입니다. 연결한 AI 모델 사용량만큼만 제공사에 지불하며, <a href="${local.models}#budget-guardrails">월간 예산 가드레일</a>을 설정하면 지정 금액(예: 월 3만 원) 도달 시 과금을 자동 멈추거나 무료 로컬 모델로 전환합니다.`,
  },
  {
    q: '어떤 AI 모델을 연결할 수 있나요?',
    a: `Anthropic Claude, OpenAI(ChatGPT), Google Gemini는 물론 교육청·대학 공용 AI 게이트웨이와 인터넷 없이 돌아가는 로컬 LLM(Ollama, vLLM)까지 모두 연결됩니다. <a href="${local.models}">모델 연결 가이드</a>를 참고하세요.`,
  },
  {
    q: '학원 운영자(원장님)와 전임·단과 강사를 위한 기능과 실제 AI 에이전트도 작동하나요?',
    a: `네! <a href="${local.studio}">에듀노드 스튜디오</a>에는 <strong>학원 운영자(원장) 모드</strong>와 <strong>학원 강사(클리닉) 모드</strong>가 기본 탑재되어 있으며, <strong>실제 AI 에이전트(Google Gemini · Anthropic Claude · 로컬 Ollama 도구 호출 런타임)</strong>와 실시간 결합되어 있습니다. 미등원/원비 미납 알림톡 초안 작성, 커트라인 미달 원생 맞춤 오답 클리닉 문항 출제, 그리고 강사 전환 시 원비 수납액을 가리는 RBAC 권한 분리까지 즉시 작동합니다.`,
  },
  {
    q: 'Google Classroom, Canvas, 학원 알림톡·결제선생과 어떻게 연동하나요?',
    a: `비밀번호를 에듀노드에 입력하지 않고 공식 인증 및 웹훅·MCP 커넥터를 통해 연결합니다. 등·하원 키오스크와 LMS는 읽기 전용으로, 카카오 알림톡·결제선생 청구·학급 공지는 반드시 승인 후 발송되도록 개별 통제합니다. <a href="${local.apps}">교육·학원 앱 연동 가이드</a>에서 절차를 확인하세요.`,
  },
];
---
<Landing
  title="에듀노드 (EduNod) · 학원 원장·강사·교사·교수자를 위한 실시간 AI 운영·수업 조교"
  ogTitle="에듀노드 (EduNod) · 학원·교무실 컴퓨터 안에서 움직이는 실제 AI 에이전트"
  description="원생·학생 개인정보와 수납 원장은 로컬에 안전하게 지키고, 등하원·미납 케어 알림톡 초안, 오답 클리닉 문항 생성, 수업 브리핑은 실제 AI 에이전트와 최종 승인 게이트(Trust Check)로 처리하는 오픈소스 교육 AI."
>
  <a class="lp-top-banner" href={local.studio}>
    <span>에듀노드 2.5 학원·학교 통합 에디션 — 학원 원장·강사 전용 모드와 실제 AI 에이전트(도구 호출)가 라이브 연결되었습니다.</span>
    <span class="lp-top-banner-cta">실시간 스튜디오 열기 →</span>
  </a>

  <div class="lp-page">
    <header class="lp-header">
      <a class="lp-logo" href="/" aria-label="에듀노드 홈">
        <img class="lockup lockup-invert" src="/img/lockup.svg" alt="EduNod EDU LABS" width="210" height="36" />
      </a>

      <nav class="lp-nav-links" aria-label="주요 메뉴">
        <a href="#pillars-title">핵심 기능</a>
        <a href="/catalog/"><strong>제품 카탈로그</strong></a>
        <a href={local.docs}>문서 가이드</a>
        <a href={local.benchmarks}>안전성 벤치마크</a>
        <a href={local.studio}><strong>스튜디오 체험</strong></a>
      </nav>

      <div class="lp-header-actions">
        <button type="button" class="lp-icon-btn" data-search aria-label="문서 및 기능 통합 검색">
          <Icon name="search" />
          <span>검색</span>
          <kbd>Ctrl K</kbd>
        </button>
        <button type="button" class="lp-icon-btn" data-theme-cycle aria-label="밝은 테마와 어두운 테마 전환">
          <Icon name="sun" />
          <span>테마</span>
        </button>
        <a class="lp-icon-btn" href={GITHUB} target="_blank" rel="noopener noreferrer" aria-label="GitHub 오픈소스 저장소">
          <Icon name="github" />
          <span>GitHub</span>
        </a>
      </div>
    </header>

    <main id="main-content" class="lp-main">
      <section class="lp-hero" aria-labelledby="hero-title">
        <div class="lp-hero-intro">
          <p class="lp-eyebrow">
            <Icon name="shield" /> 학생 데이터 로컬 격리 · 대외 발송 100% 교사 사전 승인
          </p>
          <div class="lp-hero-frame lp-dot-grid-bg">
            <h1 class="lp-h1" id="hero-title">
              <span class="lp-h1-brand" aria-hidden="true">
                EduN<Icon name="o" class="lp-o" />d
              </span>
              교사의 컴퓨터 안에서 움직이는 오픈소스 AI 수업·행정 조교
            </h1>
          </div>
          <p class="lp-hero-copy">
            등교 전 오늘의 수업·상담 브리핑을 준비하고, LMS 미제출 과제를 점검하며, 놓친 학부모·학생 문의의 답장 초안을 작성합니다. 모든 데이터는 선생님의 기기에 남고, 행동하기 전에 반드시 먼저 묻습니다.
          </p>
          <div class="lp-cta-row">
            <CrossButton href={local.studio} variant="primary">
              <Icon name="sparkles" /> 스튜디오 웹 체험하기
            </CrossButton>
            <CrossButton href={local.install} variant="secondary">
              데스크톱 · 학급 서버 설치
            </CrossButton>
          </div>
          <p class="lp-platforms">
            Windows 11 · macOS 14+ · 교무실 상시 서버(Docker) · Apache 2.0 무료 오픈소스 · 상용 API 및 폐쇄망 로컬 LLM 지원
          </p>
