---
interface Props {
  name:
    | 'o'
    | 'crosshair'
    | 'github'
    | 'arrow'
    | 'check'
    | 'phone'
    | 'team'
    | 'code'
    | 'cloud'
    | 'book'
    | 'shield'
    | 'sparkles'
    | 'search'
    | 'sun'
    | 'moon';
  class?: string;
}
const { name, class: cls } = Astro.props;
---
{name === 'o' && (
  <svg class={cls} viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <rect x="2" y="2" width="20" height="20" rx="6" stroke="currentColor" stroke-width="2.4" />
    <path d="M7.5 9.5h4.5a2 2 0 0 1 2 2v5.5H8.5a1 1 0 0 1-1-1V9.5Z" fill="var(--brand)" />
    <circle cx="17.5" cy="6.5" r="2.6" fill="var(--accent)" />
  </svg>
)}
{name === 'crosshair' && (
  <svg class={cls} viewBox="0 0 7 7" fill="none" aria-hidden="true">
    <path d="M0 3.5H7M3.5 0V7" stroke="currentColor" stroke-width="1.1" />
  </svg>
)}
{name === 'github' && (
  <svg class={cls} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
    <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
  </svg>
)}
{name === 'cloud' && (
  <svg class={cls} viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <path d="M6 15h8.5a3.5 3.5 0 0 0 .4-6.98A5 5 0 0 0 5.2 9.1 3 3 0 0 0 6 15Z" stroke="currentColor" stroke-width="1.6" />
  </svg>
)}
{name === 'phone' && (
  <svg class={cls} viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <rect x="6" y="2.5" width="8" height="15" rx="2" stroke="currentColor" stroke-width="1.6" />
    <path d="M9 14.5h2" stroke="currentColor" stroke-width="1.6" />
  </svg>
)}
{name === 'team' && (
  <svg class={cls} viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <circle cx="7" cy="7" r="2.6" stroke="currentColor" stroke-width="1.6" />
    <circle cx="13.5" cy="8" r="2.2" stroke="currentColor" stroke-width="1.6" />
    <path d="M2.5 16c.6-2.5 2.4-3.8 4.5-3.8s3.9 1.3 4.5 3.8M12 12.4c2.3-.4 4.3.8 5 3.6" stroke="currentColor" stroke-width="1.6" />
  </svg>
)}
{name === 'code' && (
  <svg class={cls} viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <path d="m7 6-4 4 4 4M13 6l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'book' && (
  <svg class={cls} viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <path d="M3 4.5A1.5 1.5 0 0 1 4.5 3H9a2 2 0 0 1 2 2v11.5a1.5 1.5 0 0 0-1.5-1.5H4.5A1.5 1.5 0 0 1 3 13.5v-9Zm14 0A1.5 1.5 0 0 0 15.5 3H11a2 2 0 0 0-2 2v11.5a1.5 1.5 0 0 1 1.5-1.5h5a1.5 1.5 0 0 0 1.5-1.5v-9Z" stroke="currentColor" stroke-width="1.6" />
  </svg>
)}
{name === 'shield' && (
  <svg class={cls} viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <path d="M10 2.5 3.5 5.2v4.6c0 4.1 2.7 6.9 6.5 8.2 3.8-1.3 6.5-4.1 6.5-8.2V5.2L10 2.5Z" stroke="currentColor" stroke-width="1.6" />
    <path d="m7.3 10.2 1.9 1.9 3.6-3.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'sparkles' && (
  <svg class={cls} viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <path d="m10 2.5 1.6 4.4 4.4 1.6-4.4 1.6L10 14.5l-1.6-4.4L4 8.5l4.4-1.6L10 2.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
    <path d="M15.5 13.5v3M14 15h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  </svg>
)}
{name === 'search' && (
  <svg class={cls} viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <circle cx="9" cy="9" r="5.8" stroke="currentColor" stroke-width="1.7" />
    <path d="m13.5 13.5 3.5 3.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
  </svg>
)}
{name === 'sun' && (
  <svg class={cls} viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <circle cx="10" cy="10" r="3.6" stroke="currentColor" stroke-width="1.6" />
    <path d="M10 2.2v2M10 15.8v2M2.2 10h2M15.8 10h2M4.5 4.5l1.4 1.4M14.1 14.1l1.4 1.4M15.5 4.5l-1.4 1.4M5.9 14.1l-1.4 1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
)}
{name === 'moon' && (
  <svg class={cls} viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <path d="M15.8 11.8A6.5 6.5 0 0 1 8.2 4.2a6.5 6.5 0 1 0 7.6 7.6Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
  </svg>
)}
{name === 'arrow' && (
  <svg class={cls} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'check' && (
  <svg class={cls} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="m3 8.5 3 3 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
