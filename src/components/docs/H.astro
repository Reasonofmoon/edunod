---
interface Props {
  id: string;
  depth?: 2 | 3;
}
const { id, depth = 2 } = Astro.props;
const Tag = depth === 3 ? 'h3' : 'h2';
const size = depth === 3 ? 17 : 20;
const text = await Astro.slots.render('default');
const plainText = text.replace(/<[^>]+>/g, '').trim();
---
<div class={`doc-heading doc-heading--${depth}`}>
  <Tag id={id} set:html={text} />
  <a class="doc-anchor" href={`#${id}`} aria-label={`"${plainText}" 섹션 링크`}>
    <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true">
      <path
        d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      />
    </svg>
  </a>
</div>
