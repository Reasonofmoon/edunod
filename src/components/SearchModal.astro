---
import { SEARCH_ITEMS } from '../data/search-index.js';
const serialized = JSON.stringify(SEARCH_ITEMS);
---
<div class="en-modal-backdrop" id="en-search-modal" hidden>
  <div class="en-search-dialog" role="dialog" aria-modal="true" aria-labelledby="en-search-label">
    <label class="sr-only" id="en-search-label" for="en-search-input">에듀노드 문서 및 기능 통합 검색</label>
    <div class="en-search-bar">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
        <path d="m20 20-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <input
        id="en-search-input"
        class="en-search-input"
        type="search"
        placeholder="기능, 문서, 학교 앱 연동, 개인정보 보호 검색… (예: 클래스룸, 승인, 로컬)"
        autocomplete="off"
      />
      <button type="button" class="en-search-esc" data-search-close aria-label="검색 창 닫기">ESC</button>
    </div>
    <ul class="en-search-results" id="en-search-results" role="listbox" aria-label="검색 결과"></ul>
    <div class="en-search-foot">
      <span>↑↓ 이동 · Enter 열기 · Esc 닫기</span>
      <span>100% 브라우저 내 로컬 검색</span>
    </div>
  </div>
</div>

<div class="en-toast" id="en-toast" role="status" aria-live="polite" hidden></div>

<script is:inline define:vars={{ serialized }}>
  (function () {
    const items = JSON.parse(serialized);
    const modal = document.getElementById('en-search-modal');
    const input = document.getElementById('en-search-input');
    const list = document.getElementById('en-search-results');
    if (!modal || !input || !list) return;

    let activeIdx = 0;
    let currentFiltered = items;
    let lastFocused = null;

    function render(query) {
      const q = (query || '').trim().toLowerCase();
      currentFiltered = !q
        ? items
        : items.filter((it) =>
            (it.title + ' ' + it.desc + ' ' + it.cat + ' ' + it.keywords).toLowerCase().includes(q)
          );
      activeIdx = 0;
      if (currentFiltered.length === 0) {
        list.innerHTML = `<li class="en-search-empty">“${q.replace(/[<>&"]/g, '')}”에 대한 검색 결과가 없습니다. 다른 키워드(예: 브리핑, 설치, 예산)를 입력해 보세요.</li>`;
        return;
      }
      list.innerHTML = currentFiltered
        .map(
          (it, idx) => `
        <li class="en-search-item" role="option" aria-selected="${idx === 0}">
          <a href="${it.href}" data-active="${idx === 0}" data-idx="${idx}">
            <span class="en-search-item-top">
              <span class="en-search-cat">${it.cat}</span>
              <span class="en-search-title">${it.title}</span>
            </span>
            <p class="en-search-desc">${it.desc}</p>
          </a>
        </li>`
        )
        .join('');
    }

    function updateHighlight(newIdx) {
      const links = list.querySelectorAll('a[data-idx]');
      if (!links.length) return;
      activeIdx = (newIdx + links.length) % links.length;
      links.forEach((a, i) => {
        const active = i === activeIdx;
        a.setAttribute('data-active', String(active));
        a.parentElement?.setAttribute('aria-selected', String(active));
        if (active) a.scrollIntoView({ block: 'nearest' });
      });
    }

    function openSearch() {
      lastFocused = document.activeElement;
      modal.hidden = false;
      render(input.value);
      requestAnimationFrame(() => input.focus());
    }

    function closeSearch() {
      modal.hidden = true;
      if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
    }

    document.querySelectorAll('[data-search]').forEach((btn) => {
      btn.addEventListener('click', openSearch);
    });
    modal.querySelectorAll('[data-search-close]').forEach((btn) => {
      btn.addEventListener('click', closeSearch);
    });
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeSearch();
    });
    list.addEventListener('click', (e) => {
      if (e.target.closest('a')) closeSearch();
    });

    input.addEventListener('input', () => render(input.value));
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        updateHighlight(activeIdx + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        updateHighlight(activeIdx - 1);
      } else if (e.key === 'Enter') {
        const target = list.querySelector(`a[data-idx="${activeIdx}"]`);
        if (target) {
          e.preventDefault();
          closeSearch();
          window.location.href = target.getAttribute('href');
        }
      }
    });

    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        modal.hidden ? openSearch() : closeSearch();
      } else if (e.key === 'Escape' && !modal.hidden) {
        e.preventDefault();
        closeSearch();
      }
    });

    // Global theme selector sync + toast helper
    window.showEduToast = function (msg) {
      const t = document.getElementById('en-toast');
      if (!t) return;
      t.textContent = msg;
      t.hidden = false;
      clearTimeout(window.__eduToastTimer);
      window.__eduToastTimer = setTimeout(() => {
        t.hidden = true;
      }, 2200);
    };

    function syncThemeControls() {
      let current = 'auto';
      try {
        current = localStorage.getItem('edunod-theme') || 'auto';
      } catch (e) {}
      document.querySelectorAll('select[data-theme]').forEach((sel) => {
        sel.value = current;
      });
    }
    syncThemeControls();

    document.querySelectorAll('select[data-theme]').forEach((sel) => {
      sel.addEventListener('change', () => {
        const v = sel.value;
        try {
          if (v === 'auto') {
            localStorage.removeItem('edunod-theme');
            document.documentElement.removeAttribute('data-theme');
          } else {
            localStorage.setItem('edunod-theme', v);
            document.documentElement.setAttribute('data-theme', v);
          }
        } catch (e) {}
        syncThemeControls();
        const label = v === 'dark' ? '어두운 화면' : v === 'light' ? '밝은 화면' : '시스템 설정';
        window.showEduToast(`화면 테마가 '${label}' 모드로 적용되었습니다.`);
      });
    });

    document.querySelectorAll('button[data-theme-cycle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const isDark =
          document.documentElement.getAttribute('data-theme') === 'dark' ||
          (!document.documentElement.getAttribute('data-theme') &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);
        const next = isDark ? 'light' : 'dark';
        try {
          localStorage.setItem('edunod-theme', next);
        } catch (e) {}
        document.documentElement.setAttribute('data-theme', next);
        syncThemeControls();
        window.showEduToast(next === 'dark' ? '다크 모드가 켜졌습니다.' : '라이트 모드가 켜졌습니다.');
      });
    });

    // Global clipboard copy buttons with immediate visual feedback
    document.querySelectorAll('button[data-copy]').forEach((b) => {
      b.addEventListener('click', () => {
        const text = b.getAttribute('data-copy') || '';
        const orig = b.textContent;
        navigator.clipboard?.writeText(text).catch(() => {});
        b.textContent = '복사 완료 ✓';
        window.showEduToast(`클립보드에 복사되었습니다: ${text}`);
        setTimeout(() => {
          b.textContent = orig;
        }, 1800);
      });
    });
  })();
</script>
