# EduNod (에듀노드) 서버 전용 AI 에이전트 환경변수 예시
# 실제 키는 .env 파일에 작성하세요 (.gitignore에 의해 Git 커밋에서 자동 제외됩니다)

# 1. Google Gemini (권장 기본 모델: gemini-2.5-flash)
GEMINI_API_KEY=

# 2. Anthropic Claude (자동 페일오버 및 선택 실행: claude-sonnet-4-20250514)
ANTHROPIC_API_KEY=

# 3. 선택 연동: OpenAI / OpenRouter / 폐쇄망 로컬 Ollama
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1

# 프로덕션 서버 포트 (npm start 실행 시 기본값 4321)
PORT=4321
